  items     RatePlanItem[]
  codes     RatePlanCode[]
  companies Company[]      @relation("CompanyDefaultRatePlan")

  @@index([hotelId])
  @@index([hotelId, isActive])
  @@index([hotelId, type])
  @@index([hotelId, companyId, isActive])
  @@index([hotelId, validFrom, validTo])
  @@map("rate_plans")
}

enum UpsellPriceType {
  FLAT
  PER_NIGHT
  PER_GUEST
}

// Per-hotel catalog of booking-engine add-ons (breakfast, late checkout,
// airport transfer, spa, ...). Nothing about the catalog is fixed globally —
// each hotel curates its own list, similarly to RatePlan.
model UpsellItem {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId     String          @map("hotel_id") @db.Uuid
  name        String
  description String?
  category    FolioItemType
  priceType   UpsellPriceType @map("price_type")
  amount      Int
  imageUrl    String?         @map("image_url")
  isActive    Boolean         @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  hotel    Hotel               @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  bookings ReservationUpsell[]

  @@index([hotelId])
  @@index([hotelId, isActive])
  @@map("upsell_items")
}

// Snapshot of an upsell selected at booking time, price-locked at selection
// since the catalog item can change or be deactivated later. Reservations
// don't have a Folio until check-in, so this holds the pending charge until
// ReservationService.updateStatus() posts it as a FolioItem.
model ReservationUpsell {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId String    @map("reservation_id") @db.Uuid
  upsellItemId  String    @map("upsell_item_id") @db.Uuid
  name          String
  category      FolioItemType
  quantity      Int       @default(1)
  unitAmount    Int       @map("unit_amount")
  amount        Int
  postedAt      DateTime? @map("posted_at")

  createdAt DateTime @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  upsellItem  UpsellItem  @relation(fields: [upsellItemId], references: [id])

  @@index([reservationId])
  @@map("reservation_upsells")
}

// Public booking-engine access codes deliberately live separately from a rate
// plan: a hotel can issue several corporate/promo codes for the same rate while
// activating, expiring, or revoking each one independently. `code` is stored
// normalized uppercase and is unique within a hotel.
model RatePlanCode {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId    String    @map("hotel_id") @db.Uuid
  ratePlanId String?   @map("rate_plan_id") @db.Uuid
  code       String
  label      String?
  validFrom  DateTime? @map("valid_from") @db.Date
  validTo    DateTime? @map("valid_to") @db.Date
  isActive   Boolean   @default(true) @map("is_active")

  // ── Per-guest issuance ────────────────────────────────────────────────────
  // A hotel-wide code spreads on WhatsApp the moment it is sent to anyone. A
  // code issued to one guest, capped at one use, cannot be forwarded usefully —
  // and tells the hotel exactly who redeemed which offer.
  /// Null for the ordinary shared corporate/promo codes this table already held.
  guestId         String?           @map("guest_id") @db.Uuid
  issueReason     PromoIssueReason? @map("issue_reason")
  /// Percentage-off guest offers apply to the best public rate for the stay.
  /// Null preserves the fixed linked-rate behaviour of existing access codes.
  discountPercent Int?              @map("discount_percent")
  /// Null means unlimited, preserving the behaviour of existing shared codes.
  maxUses         Int?              @map("max_uses")
  usedCount       Int               @default(0) @map("used_count")
  lastUsedAt      DateTime?         @map("last_used_at")
  emailStatus     PromoEmailStatus  @default(NOT_REQUESTED) @map("email_status")
  emailSentAt     DateTime?         @map("email_sent_at")
  emailError      String?           @map("email_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  hotel    Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  ratePlan RatePlan? @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  guest    Guest?    @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@unique([hotelId, code])
  @@index([hotelId, isActive])
  @@index([ratePlanId])
  @@index([guestId])
  @@map("rate_plan_codes")
}

model RatePlanItem {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ratePlanId String @map("rate_plan_id") @db.Uuid
  roomTypeId String @map("room_type_id") @db.Uuid
