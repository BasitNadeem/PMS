// ============================================================================
// Hotel PMS — Prisma Schema  v2.0
// Stack    : PostgreSQL 16 + Prisma ORM
// Updated  : Roles & Permissions tables added, HotelUser updated,
//            KITCHEN role added, indexing audit complete.
//
// MULTI-TENANCY
//   Every table carries hotel_id. RLS policies (rls_and_triggers.sql)
//   enforce isolation at DB level.
//
// ROLES & PERMISSIONS STRATEGY
//   Role, Permission, RolePermission are seeded EMPTY.
//   HotelUser keeps UserRole enum as fast JWT cache + roleId FK for Phase 2.
//
// NORMALIZATION
//   3NF throughout. Documented exceptions (trigger-maintained denormalisations):
//   - folio.balanceDue, guest.fullName, guest.totalStays, hotelUser.role
//
// MONEY
//   All monetary columns are Int (paise). Never Float. Rs 5000 = 500000.
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  OWNER
  MANAGER
  FRONT_DESK
  HOUSEKEEPING
  KITCHEN
  MAINTENANCE
  ACCOUNTANT
}

enum RoomStatus {
  VACANT_CLEAN
  VACANT_DIRTY
  OCCUPIED
  OUT_OF_ORDER
  UNDER_MAINTENANCE
  BLOCKED
}

enum RoomTypeName {
  SINGLE
  DOUBLE
  TWIN
  TRIPLE
  FAMILY
  SUITE
  DORMITORY
  COTTAGE
  TENT_GLAMPING
}

enum ReservationStatus {
  ENQUIRY
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
  CANCELLED
  WAITLISTED
}

enum BookingSource {
  WALK_IN
  PHONE
  WHATSAPP
  DIRECT_WEBSITE
  BOOKING_COM
  AGODA
  EXPEDIA
  AIRBNB
  BOOKME_PK
  SASTATICKET_PK
  TRAVEL_AGENT
  OTA_OTHER
}

enum GuestType {
  INDIVIDUAL
  GROUP
  CORPORATE
  TOUR_OPERATOR
}

enum PaymentMethod {
  CASH
  JAZZCASH
  EASYPAISA
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  CHEQUE
  ADVANCE_DEPOSIT
  OTA_COLLECT
  COMPLIMENTARY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIAL
}

enum FolioItemType {
  ROOM_CHARGE
  FOOD_BEVERAGE
  LAUNDRY
  TRANSPORT
  SPA
  ACTIVITY
  MINIBAR
  TELEPHONE
  INTERNET
  TAX
  DISCOUNT
  ADJUSTMENT
  DAMAGE_CHARGE
  MISCELLANEOUS
}

enum HousekeepingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  ESCALATED
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  AWAITING_PARTS
  RESOLVED
  CLOSED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MessageChannel {
  WHATSAPP
  BOOKING_COM
  AGODA
  EXPEDIA
  EMAIL
  SMS
  INTERNAL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum MessageStatus {
  RECEIVED
  READ
  REPLIED
  PENDING_SEND
  SENT
  DELIVERED
  FAILED
}

enum ChannelType {
  BOOKING_COM
  AGODA
  EXPEDIA
  AIRBNB
  BOOKME_PK
  SASTATICKET_PK
  CHANNEL_MANAGER
}

enum RatePlanType {
  STANDARD
  SEASONAL
  PROMOTIONAL
  CORPORATE
  TRAVEL_AGENT
  OTA_NET
  COMPLEMENTARY
}

enum InventoryTransactionType {
  PURCHASE
  CONSUMPTION
  WASTE
  ADJUSTMENT
  TRANSFER
  OPENING_STOCK
}

enum DocumentType {
  CNIC
  PASSPORT
  DRIVING_LICENSE
  NRIC
  OTHER
}

enum PropertyType {
  HOTEL
  GUESTHOUSE
  HOSTEL
  RESORT
  LODGE
  CAMPSITE
  SERVICED_APARTMENT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SUBMITTED_FBR
  ACCEPTED_FBR
  REJECTED_FBR
  VOID
}

enum TaxType {
  GST
  PST_PRA
  SST_SRB
  KPST_KPRA
  GBST_GBRA
  WHT
  ACCOMMODATION_TAX
}

// ============================================================================
// ROLES & PERMISSIONS  (v2 addition — tables seeded EMPTY)
// hotelId = NULL on system roles (apply to all hotels)
// hotelId = set   on custom roles (hotel-specific, Phase 2)
// ============================================================================

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId     String?  @db.Uuid

  name        String               // "OWNER" | "MANAGER" etc. — matches UserRole enum
  displayName String               // "Front Desk Staff"
  description String?
  color       String   @default("#6B7280")
  isSystem    Boolean  @default(true)
  isCustom    Boolean  @default(false)
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hotel       Hotel?         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  hotelUsers  HotelUser[]

  @@unique([hotelId, name])
  @@index([hotelId])
  @@index([isSystem])
  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique   // "payments:refund" — matches TS Permission type
  module      String             // "payments"
  action      String             // "refund"
  displayName String             // "Issue Refunds"
  description String?

  createdAt   DateTime @default(now())

  roles       RolePermission[]

  @@index([module])
  @@index([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  grantedAt    DateTime @default(now())
  grantedBy    String?  @db.Uuid  // userId who granted

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ============================================================================
// CORE — Hotels and Users
// ============================================================================

model Hotel {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  slug             String       @unique
  propertyType     PropertyType @default(HOTEL)

  phone            String?
  whatsappNumber   String?
  email            String?
  website          String?

  address          String?
  city             String?
  region           String?
  province         String?
  country          String       @default("PK")
  latitude         Decimal?     @db.Decimal(10, 7)
  longitude        Decimal?     @db.Decimal(10, 7)
  googlePlaceId    String?

  ntn              String?
  strn             String?
  fbrPosId         String?

  settings         Json         @default("{}")

  isActive         Boolean      @default(true)
  isTrialAccount   Boolean      @default(true)
  trialEndsAt      DateTime?
  onboardedAt      DateTime?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  roles                 Role[]
  users                 HotelUser[]
  roomTypes             RoomType[]
  rooms                 Room[]
  guests                Guest[]
  reservations          Reservation[]
  folios                Folio[]
  payments              Payment[]
  housekeepingTasks     HousekeepingTask[]
  maintenanceTickets    MaintenanceTicket[]
  messages              Message[]
  conversations         Conversation[]
  posCategories         PosCategory[]
  posItems              PosItem[]
  posOrders             PosOrder[]
  ratePlans             RatePlan[]
  channels              ChannelConfig[]
  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  staff                 Staff[]
  shiftReports          ShiftReport[]
  invoices              Invoice[]
  taxConfigs            TaxConfig[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  customFields          CustomFieldDefinition[]

  @@index([slug])
  @@index([isActive])
  @@index([region])
  @@map("hotels")
}

model User {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String      @unique
  phone                String?     @unique
  passwordHash         String
  name                 String
  avatarUrl            String?

  emailVerified        Boolean     @default(false)
  phoneVerified        Boolean     @default(false)
  lastLoginAt          DateTime?
  refreshTokenHash     String?
  passwordResetToken   String?
  passwordResetExpiry  DateTime?

  preferredLanguage    String      @default("en")
  timezone             String      @default("Asia/Karachi")

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?

  hotels                HotelUser[]
  auditLogs             AuditLog[]
  assignedTasks         HousekeepingTask[]   @relation("assignedTo")
  assignedMaintenance   MaintenanceTicket[]  @relation("assignedMaintenance")
  assignedConversations Conversation[]

  @@index([deletedAt])
  @@map("users")
}

// Updated in v2: adds roleId FK to Role table.
// role (enum) is kept as fast cache for JWT — always in sync with Role.name.
model HotelUser {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId     String    @db.Uuid
  userId      String    @db.Uuid
  role        UserRole            // fast enum cache for JWT and can() checks
  roleId      String    @db.Uuid  // FK to Role table for DB-driven permissions
  isActive    Boolean   @default(true)
  invitedAt   DateTime  @default(now())
  acceptedAt  DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedRole Role     @relation(fields: [roleId], references: [id])

  @@unique([hotelId, userId])
  @@index([hotelId])
  @@index([userId])
  @@index([hotelId, role])
  @@index([roleId])
  @@map("hotel_users")
}

// ============================================================================
// ROOMS
// ============================================================================

model RoomType {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId         String       @db.Uuid
  name            String
  typeName        RoomTypeName @default(DOUBLE)
  description     String?
  maxOccupancy    Int
  defaultRate     Int
  extraBedRate    Int          @default(0)
  amenities       String[]
  photoUrls       String[]
  sortOrder       Int          @default(0)
  isActive        Boolean      @default(true)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  hotel            Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms            Room[]
  ratePlanItems    RatePlanItem[]
  reservationRooms ReservationRoom[]

  @@index([hotelId])
  @@index([hotelId, isActive])
  @@map("room_types")
}

model Room {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId         String      @db.Uuid
  roomTypeId      String      @db.Uuid
  number          String
  floor           Int?
  status          RoomStatus  @default(VACANT_CLEAN)
  notes           String?
  isActive        Boolean     @default(true)

  lastCleanedAt   DateTime?
  lastCheckedAt   DateTime?
  lastInspectedBy String?     @db.Uuid

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  hotel              Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType           RoomType           @relation(fields: [roomTypeId], references: [id])
  reservationRooms   ReservationRoom[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]

  @@unique([hotelId, number])
  @@index([hotelId])
  @@index([hotelId, status])
  @@index([hotelId, isActive])
  @@index([roomTypeId])
  @@map("rooms")
}

// ============================================================================
// GUESTS
// ============================================================================

model Guest {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId          String       @db.Uuid

  firstName        String
  lastName         String
  fullName         String
  email            String?
  phone            String?
  alternatePhone   String?
  nationality      String?
  isForeigner      Boolean      @default(false)
  language         String?

  documentType     DocumentType @default(CNIC)
  documentNumber   String?
  documentExpiry   DateTime?
  documentScanUrl  String?
  dateOfBirth      DateTime?
  gender           String?

  address          String?
  city             String?
  country          String?

  totalStays       Int          @default(0)
  totalSpend       Int          @default(0)
  vipLevel         Int          @default(0)
  tags             String[]
  internalNotes    String?
  isBlacklisted    Boolean      @default(false)
  blacklistReason  String?

  source           BookingSource?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  hotel            Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservations     Reservation[]
  groupMembers     GroupMember[]
  conversations    Conversation[]
  blacklistEntries GuestBlacklist[]

  searchVector     Unsupported("tsvector")?

  @@index([hotelId])
  @@index([hotelId, documentNumber])
  @@index([hotelId, phone])
  @@index([hotelId, isBlacklisted])
  @@index([hotelId, isForeigner])
  @@index([hotelId, deletedAt])
  @@index([hotelId, vipLevel])
  @@map("guests")
}

model GuestBlacklist {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId         String       @db.Uuid
  guestId         String       @db.Uuid
  documentNumber  String?
  documentType    DocumentType?
  reason          String
  severity        Int          @default(1)
  isShared        Boolean      @default(false)
  sharedAt        DateTime?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  guest           Guest        @relation(fields: [guestId], references: [id])

  @@index([documentNumber])
  @@index([hotelId])
  @@index([guestId])
  @@index([isShared, documentNumber])
  @@map("guest_blacklist")
}

// ============================================================================
// RESERVATIONS
// ============================================================================

model Reservation {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId             String            @db.Uuid
  guestId             String            @db.Uuid
  groupId             String?           @db.Uuid

  confirmationNumber  String            @unique
  source              BookingSource     @default(WALK_IN)
  otaBookingRef       String?
  status              ReservationStatus @default(CONFIRMED)
  guestType           GuestType         @default(INDIVIDUAL)

  checkInDate         DateTime          @db.Date
  checkOutDate        DateTime          @db.Date
  actualCheckIn       DateTime?
  actualCheckOut      DateTime?

  adults              Int               @default(1)
  children            Int               @default(0)
  infants             Int               @default(0)

  quotedRate          Int               @default(0)
  totalAmount         Int               @default(0)
  discountAmount      Int               @default(0)
  advancePaid         Int               @default(0)
  balanceDue          Int               @default(0)

  specialRequests     String?
  internalNotes       String?
  dietaryRequirements String?
  purposeOfVisit      String?
  arrivalMode         String?
  estimatedArrivalTime DateTime?

  cancellationReason  String?
  cancelledAt         DateTime?
  cancelledBy         String?           @db.Uuid
  cancellationFee     Int               @default(0)

  isWalkIn            Boolean           @default(false)
  requiresPickup      Boolean           @default(false)
  isVip               Boolean           @default(false)

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  createdBy           String?           @db.Uuid

  hotel               Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guest               Guest             @relation(fields: [guestId], references: [id])
  group               GroupBooking?     @relation(fields: [groupId], references: [id])
  rooms               ReservationRoom[]
  folio               Folio?
  payments            Payment[]
  messages            Message[]

  @@index([hotelId, status])
  @@index([hotelId, checkInDate])
  @@index([hotelId, checkOutDate])
  @@index([hotelId, guestId])
  @@index([hotelId, source])
  @@index([hotelId, createdAt])
  @@index([hotelId, otaBookingRef])
  @@index([hotelId, checkInDate, status])
  @@map("reservations")
}

model ReservationRoom {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId   String      @db.Uuid
  roomId          String      @db.Uuid
  roomTypeId      String      @db.Uuid
  guestId         String?     @db.Uuid
  ratePerNight    Int
  checkInDate     DateTime    @db.Date
  checkOutDate    DateTime    @db.Date
  actualCheckIn   DateTime?
  actualCheckOut  DateTime?
  notes           String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  room            Room        @relation(fields: [roomId], references: [id])
  roomType        RoomType    @relation(fields: [roomTypeId], references: [id])

  @@index([reservationId])
  @@index([roomId])
  @@index([roomId, checkInDate, checkOutDate])
  @@index([roomTypeId])
  @@map("reservation_rooms")
}

// ============================================================================
// GROUP BOOKINGS
// ============================================================================

model GroupBooking {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId          String    @db.Uuid
  name             String
  groupRef         String?
  tourOperatorId   String?   @db.Uuid

  billingType      String    @default("SPLIT")
  payerType        String    @default("GUEST")
  payerName        String?
  payerContact     String?

  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  reservations     Reservation[]
  members          GroupMember[]

  @@index([hotelId])
  @@index([hotelId, tourOperatorId])
  @@map("group_bookings")
}

model GroupMember {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId       String       @db.Uuid
  guestId       String       @db.Uuid
  isLeader      Boolean      @default(false)
  roomPreference String?

  createdAt     DateTime     @default(now())

  group         GroupBooking @relation(fields: [groupId], references: [id], onDelete: Cascade)
  guest         Guest        @relation(fields: [guestId], references: [id])

  @@unique([groupId, guestId])
  @@index([groupId])
  @@index([guestId])
  @@map("group_members")
}

// ============================================================================
// FOLIO & PAYMENTS
// ============================================================================

model Folio {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId         String    @db.Uuid
  reservationId   String    @unique @db.Uuid
  folioNumber     String    @unique

  chargesTotal    Int       @default(0)
  discountsTotal  Int       @default(0)
  taxTotal        Int       @default(0)
  paymentsTotal   Int       @default(0)
  balanceDue      Int       @default(0)

  isOpen          Boolean   @default(true)
  closedAt        DateTime?
  closedBy        String?   @db.Uuid

  invoiceId       String?   @db.Uuid

  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hotel       Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id])
  items       FolioItem[]
  payments    Payment[]
  splitFolios FolioSplit[]
  invoice     Invoice?    @relation(fields: [invoiceId], references: [id])

  @@index([hotelId])
  @@index([hotelId, isOpen])
  @@index([hotelId, closedAt])
  @@map("folios")
}

model FolioItem {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId         String        @db.Uuid
  folioId         String        @db.Uuid
  type            FolioItemType
  description     String
  quantity        Int           @default(1)
  unitAmount      Int
  amount          Int
  discountAmount  Int           @default(0)
  taxAmount       Int           @default(0)
  netAmount       Int

  posOrderItemId  String?       @db.Uuid
  roomId          String?       @db.Uuid
  staffId         String?       @db.Uuid

  chargeDate      DateTime      @default(now())
  isVoided        Boolean       @default(false)
  voidedAt        DateTime?
  voidedBy        String?       @db.Uuid
  voidReason      String?

  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  folio        Folio         @relation(fields: [folioId], references: [id], onDelete: Cascade)
  posOrderItem PosOrderItem? @relation(fields: [posOrderItemId], references: [id])

  @@index([folioId])
  @@index([hotelId, chargeDate])
  @@index([hotelId, type])
  @@index([posOrderItemId])
  @@map("folio_items")
}

model FolioSplit {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  folioId     String   @db.Uuid
  payerName   String
  payerType   String
  payerRef    String?
  amount      Int
  isPaid      Boolean  @default(false)
  paidAt      DateTime?
  notes       String?

  createdAt   DateTime @default(now())

  folio       Folio    @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId])
  @@map("folio_splits")
}

model Payment {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId         String        @db.Uuid
  folioId         String?       @db.Uuid
  reservationId   String?       @db.Uuid
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Int
  currencyCode    String        @default("PKR")
  exchangeRate    Decimal?      @db.Decimal(10, 4)

  transactionRef  String?
  gatewayResponse Json?

  cashDenominations Json?
  receiptNumber   String?

  isRefund        Boolean       @default(false)
  originalPaymentId String?     @db.Uuid
  refundReason    String?

  postedAt        DateTime      @default(now())
  postedBy        String?       @db.Uuid
  notes           String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hotel       Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  folio       Folio?       @relation(fields: [folioId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  @@index([hotelId, postedAt])
  @@index([hotelId, method])
  @@index([hotelId, status])
  @@index([folioId])
  @@index([reservationId])
  @@index([originalPaymentId])
  @@map("payments")
}

// ============================================================================
// POINT OF SALE
// ============================================================================

model PosCategory {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId     String    @db.Uuid
  name        String
  icon        String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  hotel       Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  items       PosItem[]

  @@index([hotelId])
  @@index([hotelId, isActive])
  @@map("pos_categories")
}

model PosItem {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId           String      @db.Uuid
  categoryId        String      @db.Uuid
  name              String
  nameUrdu          String?
  description       String?
  price             Int
  taxRate           Decimal     @default(0) @db.Decimal(5, 4)
  unit              String      @default("piece")

  inventoryItemId   String?     @db.Uuid
  inventoryQtyUsed  Decimal?    @db.Decimal(10, 3)

  isAvailable       Boolean     @default(true)
  isKitchenItem     Boolean     @default(true)
  sortOrder         Int         @default(0)
  photoUrl          String?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  hotel         Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  category      PosCategory    @relation(fields: [categoryId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  orderItems    PosOrderItem[]

  @@index([hotelId])
  @@index([hotelId, categoryId])
  @@index([hotelId, isAvailable])
  @@index([inventoryItemId])
