// ============================================================================
// CORPORATE BILLING / CREDIT ACCOUNTS
// ============================================================================
//
// A Company is a durable counterparty — a tour agency, a corporate client, a
// government department. Before this existed, the payer was free text on each
// group booking ("Al-Habib Travels" retyped every time), so there was no way to
// ask "what does this agency owe us?".
//
// The money model is a city ledger. Each stay keeps its own folio for
// itemisation; at checkout an unpaid folio can be TRANSFERRED to the company,
// which closes the folio and opens a CHARGE on the company ledger with a due
// date derived from the company's payment terms. Payments arrive later against
// the company, not the folio, and are allocated across open charges.

enum CompanyType {
  TOUR_AGENCY
  CORPORATE
  GOVERNMENT
  NGO
  OTHER
}

/// Net days until a transferred charge falls due. IMMEDIATE means the company
/// is on the books for reporting but is not actually extended credit.
enum CompanyPaymentTerms {
  IMMEDIATE
  NET_7
  NET_15
  NET_30
  NET_45
  NET_60
  NET_90
}

enum CompanyLedgerEntryType {
  CHARGE
  PAYMENT
  ADJUSTMENT
  WRITE_OFF
  CREDIT_REFUND
}

enum CompanyInvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

model Company {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId String @map("hotel_id") @db.Uuid

  name         String
  type         CompanyType @default(TOUR_AGENCY)
  code         String?
  contactName  String?     @map("contact_name")
  contactPhone String?     @map("contact_phone")
  contactEmail String?     @map("contact_email")
  address      String?
  city         String?

  /// National Tax Number — printed on the consolidated invoice. Optional
  /// because plenty of small agencies are not registered.
  ntn  String?
  /// Sales Tax Registration Number, likewise optional.
  strn String?

  /// Minor units (paisa). 0 means no credit — charges cannot be transferred.
  creditLimit  BigInt              @default(0) @map("credit_limit")
  paymentTerms CompanyPaymentTerms @default(NET_30) @map("payment_terms")

  /// Denormalised running balance in paisa, kept in step with the ledger inside
  /// the same transaction. Positive means the company owes the hotel.
  balance BigInt @default(0)

  /// Negotiated rate defaults. Either a rate plan the company always books on,
  /// or a flat percentage off the applicable public rate. Both are only
  /// defaults — the booking screen pre-fills from them and stays editable.
  ratePlanId      String? @map("rate_plan_id") @db.Uuid
  discountPercent Int?    @map("discount_percent")

  isActive Boolean @default(true) @map("is_active")
  notes    String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  hotel               Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  ratePlan            RatePlan?            @relation("CompanyDefaultRatePlan", fields: [ratePlanId], references: [id])
  /// Seasonal/fixed contracts owned by this company. These are ordinary rate
  /// plans underneath, so the hotel has one pricing engine and one audit trail.
  contractedRatePlans RatePlan[]           @relation("CompanyContractRatePlans")
  ledgerEntries       CompanyLedgerEntry[]
  invoices            CompanyInvoice[]
  reservations        Reservation[]
  groupBookings       GroupBooking[]

  @@unique([hotelId, name])
  @@index([hotelId])
  @@index([hotelId, isActive])
  @@index([hotelId, type])
  @@map("companies")
}

model CompanyLedgerEntry {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId   String @map("hotel_id") @db.Uuid
  companyId String @map("company_id") @db.Uuid

  type        CompanyLedgerEntryType
  /// Always positive, in paisa. The sign is implied by `type`: CHARGE and
  /// ADJUSTMENT increase the balance, PAYMENT and WRITE_OFF decrease it.
  /// Storing an unsigned amount keeps the aging maths from having to special
  /// case negative charges.
  amount      BigInt
  description String

  entryDate DateTime  @map("entry_date")
  /// Set on CHARGE rows only, from the company's payment terms at transfer time.
  dueDate   DateTime? @map("due_date")

  /// CHARGE rows only: how much of `amount` has been covered by payments.
  /// A charge is settled when settledAmount == amount.
  settledAmount BigInt @default(0) @map("settled_amount")

  /// Durable identity supplied by the client/workflow. Retries return the
  /// original movement rather than duplicating company debt or a payment.
  sourceKey String? @map("source_key")

  /// Financial rows are never deleted. A mistaken payment is reversed by
  /// marking the original and recording the compensating cash movement.
  reversedAt     DateTime? @map("reversed_at")
  reversedBy     String?   @map("reversed_by") @db.Uuid
  reversalReason String?   @map("reversal_reason")

  /// Provenance for CHARGE rows — the folio that was transferred here.
  folioId       String?   @map("folio_id") @db.Uuid
  reservationId String?   @map("reservation_id") @db.Uuid
  /// Snapshot so the statement still reads correctly if the guest is renamed
  /// or deleted years later.
  guestName     String?   @map("guest_name")
  roomNumber    String?   @map("room_number")
  stayFrom      DateTime? @map("stay_from") @db.Date
  stayTo        DateTime? @map("stay_to") @db.Date

  /// PAYMENT rows only.
  paymentMethod PaymentMethod? @map("payment_method")
  reference     String?

  invoiceId String? @map("invoice_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  hotel   Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  folio   Folio?          @relation(fields: [folioId], references: [id])
  invoice CompanyInvoice? @relation(fields: [invoiceId], references: [id])

  @@index([hotelId])
  @@index([companyId, entryDate])
  @@index([companyId, type, settledAmount])
  @@index([hotelId, dueDate])
  @@index([invoiceId])
  @@unique([hotelId, sourceKey])
  @@map("company_ledger_entries")
}

model CompanyInvoice {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId   String @map("hotel_id") @db.Uuid
  companyId String @map("company_id") @db.Uuid

  invoiceNumber String               @map("invoice_number")
  status        CompanyInvoiceStatus @default(DRAFT)

  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date

  /// Totals in paisa, frozen when the invoice is issued.
  subtotal    BigInt @default(0)
  taxAmount   BigInt @default(0) @map("tax_amount")
  totalAmount BigInt @default(0) @map("total_amount")
  paidAmount  BigInt @default(0) @map("paid_amount")

  issuedAt DateTime? @map("issued_at")
  dueDate  DateTime? @map("due_date")
  notes    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid

  hotel   Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  company Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   CompanyLedgerEntry[]

  @@index([hotelId])
  @@index([companyId, periodEnd])
  @@index([hotelId, status])
  @@unique([hotelId, invoiceNumber])
  @@map("company_invoices")
}

// ============================================================================
// GROUP BOOKINGS
// ============================================================================

model GroupBooking {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId        String  @map("hotel_id") @db.Uuid
  name           String
  groupRef       String? @map("group_ref")
  tourOperatorId String? @map("tour_operator_id") @db.Uuid

  /// Preferred over the free-text payerName/payerContact below, which are kept
  /// for groups booked before companies existed and for one-off payers that
  /// nobody wants a permanent record for.
  companyId String? @map("company_id") @db.Uuid

  billingType  String  @default("SPLIT") @map("billing_type")
  payerType    String  @default("GUEST") @map("payer_type")
  payerName    String? @map("payer_name")
  payerContact String? @map("payer_contact")

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reservations Reservation[]
  members      GroupMember[]
  company      Company?      @relation(fields: [companyId], references: [id])

  @@index([hotelId])
  @@index([hotelId, tourOperatorId])
  @@index([hotelId, companyId])
  @@map("group_bookings")
}

model GroupMember {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId        String  @map("group_id") @db.Uuid
  guestId        String  @map("guest_id") @db.Uuid
  isLeader       Boolean @default(false) @map("is_leader")
  roomPreference String? @map("room_preference")

  createdAt DateTime @default(now()) @map("created_at")

  group GroupBooking @relation(fields: [groupId], references: [id], onDelete: Cascade)
  guest Guest        @relation(fields: [guestId], references: [id])

  @@unique([groupId, guestId])
  @@index([groupId])
  @@index([guestId])
  @@map("group_members")
}

// ============================================================================
// FOLIO & PAYMENTS
// ============================================================================

model Folio {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId       String @map("hotel_id") @db.Uuid
  reservationId String @unique @map("reservation_id") @db.Uuid
  folioNumber   String @unique @map("folio_number")

  chargesTotal   Int @default(0) @map("charges_total")
  discountsTotal Int @default(0) @map("discounts_total")
  taxTotal       Int @default(0) @map("tax_total")
  paymentsTotal  Int @default(0) @map("payments_total")
  balanceDue     Int @default(0) @map("balance_due")

  isOpen   Boolean   @default(true) @map("is_open")
  closedAt DateTime? @map("closed_at")
  closedBy String?   @map("closed_by") @db.Uuid

  invoiceId String? @map("invoice_id") @db.Uuid

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  hotel                Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservation          Reservation          @relation(fields: [reservationId], references: [id])
  items                FolioItem[]
  payments             Payment[]
  splitFolios          FolioSplit[]
  companyLedgerEntries CompanyLedgerEntry[]
  invoice              Invoice?             @relation(fields: [invoiceId], references: [id])

  @@index([hotelId])
  @@index([hotelId, isOpen])
  @@index([hotelId, closedAt])
  @@map("folios")
}

model FolioItem {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId        String        @map("hotel_id") @db.Uuid
  folioId        String        @map("folio_id") @db.Uuid
  type           FolioItemType
  description    String
  quantity       Int           @default(1)
  unitAmount     Int           @map("unit_amount")
  amount         Int
  discountAmount Int           @default(0) @map("discount_amount")
  taxAmount      Int           @default(0) @map("tax_amount")
  netAmount      Int           @map("net_amount")

  posOrderItemId String? @map("pos_order_item_id") @db.Uuid
  roomId         String? @map("room_id") @db.Uuid
  staffId        String? @map("staff_id") @db.Uuid

  chargeDate DateTime  @default(now()) @map("charge_date")
  isVoided   Boolean   @default(false) @map("is_voided")
  voidedAt   DateTime? @map("voided_at")
  voidedBy   String?   @map("voided_by") @db.Uuid
  voidReason String?   @map("void_reason")

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  folio        Folio         @relation(fields: [folioId], references: [id], onDelete: Cascade)
  posOrderItem PosOrderItem? @relation(fields: [posOrderItemId], references: [id])

  @@index([folioId])
  @@index([hotelId, chargeDate])
  @@index([hotelId, type])
  @@index([posOrderItemId])
  @@map("folio_items")
}

model FolioSplit {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  folioId   String    @map("folio_id") @db.Uuid
  payerName String    @map("payer_name")
  payerType String    @map("payer_type")
  payerRef  String?   @map("payer_ref")
  amount    Int
  isPaid    Boolean   @default(false) @map("is_paid")
  paidAt    DateTime? @map("paid_at")
  notes     String?

  createdAt DateTime @default(now()) @map("created_at")

  folio Folio @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId])
  @@map("folio_splits")
}

model Payment {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId       String        @map("hotel_id") @db.Uuid
  folioId       String?       @map("folio_id") @db.Uuid
  reservationId String?       @map("reservation_id") @db.Uuid
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Int
  currencyCode  String        @default("PKR") @map("currency_code")
  exchangeRate  Decimal?      @map("exchange_rate") @db.Decimal(10, 4)

  transactionRef  String? @map("transaction_ref")
  gatewayResponse Json?   @map("gateway_response")

  cashDenominations Json?   @map("cash_denominations")
  receiptNumber     String? @map("receipt_number")

  isRefund          Boolean @default(false) @map("is_refund")
  originalPaymentId String? @map("original_payment_id") @db.Uuid
  refundReason      String? @map("refund_reason")

  postedAt DateTime @default(now()) @map("posted_at")
  postedBy String?  @map("posted_by") @db.Uuid
  notes    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  hotel       Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  folio       Folio?       @relation(fields: [folioId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  @@index([hotelId, postedAt])
  @@index([hotelId, method])
  @@index([hotelId, status])
  @@index([folioId])
  @@index([reservationId])
  @@index([originalPaymentId])
  @@map("payments")
}

// ============================================================================
// POINT OF SALE
// ============================================================================

model PosCategory {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId   String  @map("hotel_id") @db.Uuid
  name      String
  icon      String?
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  // QR guest-menu visibility — independent of isActive (POS-facing).
  // availableFrom/availableUntil are "HH:MM" strings; both null = always available.
  isQrVisible    Boolean @default(true) @map("is_qr_visible")
  availableFrom  String? @map("available_from")
  availableUntil String? @map("available_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  hotel Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  items PosItem[]

  @@index([hotelId])
  @@index([hotelId, isActive])
  @@map("pos_categories")
