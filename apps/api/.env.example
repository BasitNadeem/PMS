DATABASE_URL="postgresql://hotel_pms_app:pms_app_dev_pass@localhost:5433/hotel_pms?schema=public"
DIRECT_URL="postgresql://pms_user:pms_pass@localhost:5433/hotel_pms?schema=public"
JWT_SECRET="change-me-in-production-use-openssl-rand-base64-32"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=4000
NODE_ENV=development

# Local-dev-only CORS bypass — allows any origin to call the API. Safe here because this
# is the local development template, never the one copied for production deployments.
ALLOW_DEV_CORS_BYPASS=true

# Get from Brevo dashboard → Settings → SMTP & API → API Keys
BREVO_API_KEY="your-brevo-api-key"
BREVO_FROM_EMAIL="noreply@innflo.co"
BREVO_FROM_NAME="Innflo Bookings"
