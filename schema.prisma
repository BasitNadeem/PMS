  sku             String?
  category        String
  unit            String
  currentStock    Decimal   @default(0) @db.Decimal(12, 3)
  parLevel        Decimal   @default(0) @db.Decimal(12, 3)
  reorderLevel    Decimal   @default(0) @db.Decimal(12, 3)
  costPerUnit     Int       @default(0)
  supplier        String?
  isActive        Boolean   @default(true)

  createdAt       DateTime  @default(now())
