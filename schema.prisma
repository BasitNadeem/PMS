  @@index([hotelId, itemId])
  @@index([hotelId, createdAt])
  @@index([itemId, createdAt])
  @@index([hotelId, type])
  @@map("inventory_transactions")
}

// ============================================================================
// MESSAGING / UNIFIED INBOX
// ============================================================================

model Conversation {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId         String          @db.Uuid
  guestId         String?         @db.Uuid
  reservationId   String?         @db.Uuid
  assignedToId    String?         @db.Uuid
  subject         String?
  channel         MessageChannel  @default(WHATSAPP)

  isOpen          Boolean         @default(true)
  isRead          Boolean         @default(false)
  isSnoozed       Boolean         @default(false)
  snoozedUntil    DateTime?
  lastMessageAt   DateTime?
  unreadCount     Int             @default(0)

  tags            String[]
  internalNotes   String?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  hotel      Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guest      Guest?    @relation(fields: [guestId], references: [id])
  assignedTo User?     @relation(fields: [assignedToId], references: [id])
  messages   Message[]

  @@index([hotelId, isOpen])
  @@index([hotelId, guestId])
  @@index([hotelId, lastMessageAt])
  @@index([hotelId, isRead])
  @@index([assignedToId])
  @@map("conversations")
}

model Message {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId           String           @db.Uuid
  conversationId    String           @db.Uuid
  reservationId     String?          @db.Uuid
  channel           MessageChannel
  direction         MessageDirection
  status            MessageStatus    @default(RECEIVED)

  body              String
  mediaUrls         String[]
  isTemplate        Boolean          @default(false)
  templateName      String?

  externalMessageId String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failureReason     String?

  senderName        String?
  senderPhone       String?
  staffId           String?          @db.Uuid

  createdAt         DateTime         @default(now())

  hotel        Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reservation  Reservation? @relation(fields: [reservationId], references: [id])

  @@index([conversationId])
  @@index([hotelId, createdAt])
  @@index([externalMessageId])
  @@index([hotelId, direction, status])
  @@map("messages")
}

