# ── App runtime DB (hotel_pms_app role — subject to RLS) ────────────────────
# After running `pnpm apply:rls`, the app must connect as this restricted role.
# RLS policies are enforced here; cross-tenant data leaks are impossible.
DATABASE_URL="postgresql://hotel_pms_app:pms_app_dev_pass@localhost:5433/hotel_pms?schema=public"

# ── Admin / migration DB (pms_user superuser — bypasses RLS) ────────────────
# Used by: prisma migrate, apply-rls script, seed, studio
# NEVER expose this URL in the app runtime.
DIRECT_URL="postgresql://pms_user:pms_pass@localhost:5433/hotel_pms?schema=public"

# ── App-role password (set by apply-rls script) ─────────────────────────────
DB_APP_PASSWORD="pms_app_dev_pass"

# ── API ───────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production-use-openssl-rand-base64-32"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=4000
NODE_ENV=development

# ── Web ───────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
