  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  orderItems    PosOrderItem[]

  @@index([hotelId])
  @@index([hotelId, categoryId])
  @@index([hotelId, isAvailable])
  @@index([inventoryItemId])
  @@map("pos_items")
