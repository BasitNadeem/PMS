{
  "name": "hotel-pms",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "dotenv -e .env -- pnpm --filter @pms/db generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @pms/db migrate:dev",
    "db:migrate:deploy": "dotenv -e .env -- pnpm --filter @pms/db migrate:deploy",
    "db:push": "dotenv -e .env -- pnpm --filter @pms/db db:push",
    "db:studio": "dotenv -e .env -- pnpm --filter @pms/db studio",
    "db:seed": "dotenv -e .env -- pnpm --filter @pms/db seed",
    "apply:rls": "tsx --env-file=.env scripts/apply-rls.ts",
    "setup": "pnpm docker:up && sleep 3 && pnpm db:migrate && pnpm apply:rls && pnpm db:generate && pnpm db:seed",
    "fresh-setup": "bash scripts/fresh-setup.sh",
    "verify-db": "bash scripts/verify-db.sh",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "dotenv-cli": "^7.4.4",
    "pg": "^8.13.3",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
