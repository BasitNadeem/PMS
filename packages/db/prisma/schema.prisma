  internalNotes        String?   @map("internal_notes")
  dietaryRequirements  String?   @map("dietary_requirements")
  purposeOfVisit       String?   @map("purpose_of_visit")
  arrivalMode          String?   @map("arrival_mode")
  estimatedArrivalTime DateTime? @map("estimated_arrival_time")

  cancellationReason          String?   @map("cancellation_reason")
  cancelledAt                 DateTime? @map("cancelled_at")
  cancelledBy                 String?   @map("cancelled_by") @db.Uuid
  cancellationFee             Int       @default(0) @map("cancellation_fee")
  cancellationPolicySnapshot  String?   @map("cancellation_policy_snapshot") @db.Text
  bookingPaymentTermsSnapshot String?   @map("booking_payment_terms_snapshot") @db.Text
