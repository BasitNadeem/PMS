# Origin of the Innflo API, used by the contact form to record walkthrough
# requests before any WhatsApp hand-off. No trailing slash.
#
# OPTIONAL. When unset the code falls back to https://api.innflo.co in a
# production build and http://localhost:4000 in dev. Do NOT set this to an
# empty string: unlike apps/web, empty does not mean "same origin" here —
# innflo.co/api/* is served by the static site and returns HTML, not JSON.
#
# Everything in this file ships inside a public static bundle — never put a
# secret in a VITE_ variable.
#
# Local development: http://localhost:4000
VITE_API_URL=https://api.innflo.co
