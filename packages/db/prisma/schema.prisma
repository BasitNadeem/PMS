// ============================================================================
// ROLES & PERMISSIONS  (v2 addition — tables seeded EMPTY)
// hotelId = NULL on system roles (apply to all hotels)
// hotelId = set   on custom roles (hotel-specific, Phase 2)
// ============================================================================

model Role {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId String? @map("hotel_id") @db.Uuid

  name        String // "OWNER" | "MANAGER" etc. — matches UserRole enum
  displayName String  @map("display_name") // "Front Desk Staff"
  description String?
  color       String  @default("#6B7280")
  isSystem    Boolean @default(true) @map("is_system")
  isCustom    Boolean @default(false) @map("is_custom")
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  hotel       Hotel?           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  hotelUsers  HotelUser[]

  // NOTE: this composite unique constraint does not stop duplicate system
  // roles (hotelId = NULL) — Postgres never treats two NULLs as equal in a
  // unique index. The real guard for that case is a partial unique index
  // (roles_system_name_key, ON (name) WHERE hotel_id IS NULL) added by
  // migration 20260706000000_dedupe_system_roles_and_fix_constraint — Prisma's
  // schema DSL can't express a partial index, so it only exists in raw SQL
  // and won't show up here. Don't let a future `prisma migrate dev` drop it.
  @@unique([hotelId, name])
  @@index([hotelId])
  @@index([isSystem])
  @@map("roles")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String  @unique // "payments:refund" — matches TS Permission type
  module      String // "payments"
  action      String // "refund"
  displayName String  @map("display_name") // "Issue Refunds"
  description String?

  createdAt DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([module])
  @@index([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at")
  grantedBy    String?  @map("granted_by") @db.Uuid // userId who granted

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ============================================================================
// CORE — Hotels and Users
// ============================================================================

model Hotel {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  slug         String       @unique
  propertyType PropertyType @default(HOTEL) @map("property_type")
  description  String?
  amenities    String[]     @default([])

  phone          String?
  whatsappNumber String? @map("whatsapp_number")
  email          String?
  website        String?

  address       String?
  city          String?
  region        String?
  province      String?
  country       String   @default("PK")
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  googlePlaceId String?  @map("google_place_id")

  ntn      String?
  strn     String?
  fbrPosId String? @map("fbr_pos_id")

  settings            Json    @default("{}")
  cancellationPolicy  String? @map("cancellation_policy") @db.Text
  bookingPaymentTerms String? @map("booking_payment_terms") @db.Text

  isActive       Boolean   @default(true) @map("is_active")
  isTrialAccount Boolean   @default(true) @map("is_trial_account")
  trialEndsAt    DateTime? @map("trial_ends_at")
  onboardedAt    DateTime? @map("onboarded_at")

  subdomain           String? @unique @map("subdomain")
  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  onboardingStep      Int     @default(0) @map("onboarding_step")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  roles                 Role[]
  users                 HotelUser[]
  roomTypes             RoomType[]
  rooms                 Room[]
  guests                Guest[]
  guestSpecialDates     GuestSpecialDate[]
  companies             Company[]
  companyLedgerEntries  CompanyLedgerEntry[]
  companyInvoices       CompanyInvoice[]
  accountingAccounts    AccountingAccount[]
  accountingExports     AccountingExport[]
  reservations          Reservation[]
  folios                Folio[]
  payments              Payment[]
  housekeepingTasks     HousekeepingTask[]
  maintenanceTickets    MaintenanceTicket[]
  messages              Message[]
  conversations         Conversation[]
  posCategories         PosCategory[]
  posItems              PosItem[]
  posOrders             PosOrder[]
  ratePlans             RatePlan[]
  ratePlanCodes         RatePlanCode[]
  upsellItems           UpsellItem[]
  channels              ChannelConfig[]
  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  staff                 Staff[]
  shiftReports          ShiftReport[]
  invoices              Invoice[]
  taxConfigs            TaxConfig[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  customFields          CustomFieldDefinition[]
  frontDeskNotes        FrontDeskNote[]
  pushSubscriptions     PushSubscription[]
  currentBusinessDate   DateTime?               @map("current_business_date") @db.Date
  nightAuditRecords     NightAuditRecord[]
  subscriptionPlanId    String?                 @map("subscription_plan_id") @db.Uuid
  subscriptionPlan      SubscriptionPlan?       @relation(fields: [subscriptionPlanId], references: [id])
  limitOverrides        Json?                   @map("limit_overrides")
  featureOverrides      Json?                   @map("feature_overrides")

  @@index([slug])
  @@index([isActive])
  @@index([region])
  @@map("hotels")
}

model NightAuditRecord {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId          String   @db.Uuid
  businessDate     DateTime @db.Date
  runAt            DateTime @default(now())
  runBy            String   @db.Uuid
  occupancyRate    Decimal
  roomRevenue      Int
  posRevenue       Int
  totalCollected   Int
  totalOutstanding Int
  noShowsFlagged   Int      @default(0)
  openBalanceCount Int      @default(0)
  snapshot         Json
  hotel            Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, businessDate])
  @@index([hotelId, businessDate])
  @@map("night_audit_records")
}

model SubscriptionPlan {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  slug         String   @unique
  priceMonthly Int      @map("price_monthly")
  limits       Json     @default("{}")
  features     Json
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  hotels       Hotel[]

  @@map("subscription_plans")
}

model User {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String  @unique
  phone        String? @unique
  passwordHash String  @map("password_hash")
  name         String
  avatarUrl    String? @map("avatar_url")

  emailVerified       Boolean   @default(false) @map("email_verified")
  phoneVerified       Boolean   @default(false) @map("phone_verified")
  lastLoginAt         DateTime? @map("last_login_at")
  refreshTokenHash    String?   @map("refresh_token_hash")
  passwordResetToken  String?   @map("password_reset_token")
  passwordResetExpiry DateTime? @map("password_reset_expiry")

  preferredLanguage String @default("en") @map("preferred_language")
  timezone          String @default("Asia/Karachi")

  isSuperAdmin Boolean @default(false) @map("is_super_admin")
  isFirstLogin Boolean @default(true) @map("is_first_login")
  tempPassword String? @map("temp_password")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  hotels                HotelUser[]
  auditLogs             AuditLog[]
  assignedTasks         HousekeepingTask[]  @relation("assignedTo")
  assignedMaintenance   MaintenanceTicket[] @relation("assignedMaintenance")
  assignedConversations Conversation[]
  notesCreated          FrontDeskNote[]     @relation("NoteCreatedBy")
  notesCompleted        FrontDeskNote[]     @relation("NoteCompletedBy")
  pushSubscriptions     PushSubscription[]

  @@index([deletedAt])
  @@map("users")
}

// Updated in v2: adds roleId FK to Role table.
// role (enum) is kept as fast cache for JWT — always in sync with Role.name.
model HotelUser {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId    String    @map("hotel_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  role       UserRole // fast enum cache for JWT and can() checks
  roleId     String    @map("role_id") @db.Uuid // FK to Role table for DB-driven permissions
  isActive   Boolean   @default(true) @map("is_active")
  invitedAt  DateTime  @default(now()) @map("invited_at")
  acceptedAt DateTime? @map("accepted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  hotel        Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user         User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedRole Role  @relation(fields: [roleId], references: [id])

  @@unique([hotelId, userId])
  @@index([hotelId])
  @@index([userId])
  @@index([hotelId, role])
  @@index([roleId])
  @@map("hotel_users")
}

// ============================================================================
// ROOMS
// ============================================================================

model RoomType {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId      String       @map("hotel_id") @db.Uuid
  name         String
  typeName     RoomTypeName @default(DOUBLE) @map("type_name")
  description  String?
  maxOccupancy Int          @map("max_occupancy")
  defaultRate  Int          @map("default_rate")
  extraBedRate Int          @default(0) @map("extra_bed_rate")
  amenities    String[]
  photoUrls    String[]     @map("photo_urls")
  sortOrder    Int          @default(0) @map("sort_order")
  isActive     Boolean      @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  hotel            Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms            Room[]
  ratePlanItems    RatePlanItem[]
  reservationRooms ReservationRoom[]

  @@index([hotelId])
  @@index([hotelId, isActive])
  @@map("room_types")
}

model Room {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId    String     @map("hotel_id") @db.Uuid
  roomTypeId String     @map("room_type_id") @db.Uuid
  number     String
  floor      Int?
  status     RoomStatus @default(VACANT_CLEAN)
  notes      String?
  isActive   Boolean    @default(true) @map("is_active")

  lastCleanedAt   DateTime? @map("last_cleaned_at")
  lastCheckedAt   DateTime? @map("last_checked_at")
  lastInspectedBy String?   @map("last_inspected_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  hotel              Hotel               @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType           RoomType            @relation(fields: [roomTypeId], references: [id])
  reservationRooms   ReservationRoom[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]

  @@unique([hotelId, number])
  @@index([hotelId])
  @@index([hotelId, status])
  @@index([hotelId, isActive])
  @@index([roomTypeId])
  @@map("rooms")
}

// ============================================================================
// GUESTS
// ============================================================================

model Guest {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId String @map("hotel_id") @db.Uuid

  firstName      String  @map("first_name")
  lastName       String  @map("last_name")
  fullName       String  @map("full_name")
  email          String?
  phone          String?
  alternatePhone String? @map("alternate_phone")
  nationality    String?
  isForeigner    Boolean @default(false) @map("is_foreigner")
  language       String?

  documentType    DocumentType @default(CNIC) @map("document_type")
  documentNumber  String?      @map("document_number")
  documentExpiry  DateTime?    @map("document_expiry")
  documentScanUrl String?      @map("document_scan_url")
  dateOfBirth     DateTime?    @map("date_of_birth")
  gender          String?

  address String?
  city    String?
  country String?

  totalStays    Int      @default(0) @map("total_stays")
  totalSpend    Int      @default(0) @map("total_spend")
  vipLevel      Int      @default(0) @map("vip_level")
  tags          String[]
  internalNotes String?  @map("internal_notes")

  // Set when a guest has been asked for a birthday/anniversary and chose not to
  // share it. Without this, "no date on file" is indistinguishable from "never
  // asked" and the front desk keeps re-asking the same guest every visit.
  specialDatesDeclinedAt DateTime? @map("special_dates_declined_at")
  // Explicit permission to send greetings. Holding a date — often captured off
  // a CNIC for compliance — is not the same as consent to market to someone.
  marketingOptIn         Boolean   @default(false) @map("marketing_opt_in")
  marketingOptInAt       DateTime? @map("marketing_opt_in_at")
  isBlacklisted          Boolean   @default(false) @map("is_blacklisted")
  blacklistReason        String?   @map("blacklist_reason")

  source    BookingSource?
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  deletedAt DateTime?      @map("deleted_at")

  hotel            Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservations     Reservation[]
  groupMembers     GroupMember[]
  conversations    Conversation[]
  blacklistEntries GuestBlacklist[]
  specialDates     GuestSpecialDate[]
  promoCodes       RatePlanCode[]

  searchVector Unsupported("tsvector")? @map("search_vector")

  @@index([hotelId])
  @@index([hotelId, documentNumber])
  @@index([hotelId, phone])
  @@index([hotelId, isBlacklisted])
  @@index([hotelId, isForeigner])
  @@index([hotelId, deletedAt])
  @@index([hotelId, vipLevel])
  @@map("guests")
}

model GuestBlacklist {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId        String        @map("hotel_id") @db.Uuid
  guestId        String        @map("guest_id") @db.Uuid
  documentNumber String?       @map("document_number")
  documentType   DocumentType? @map("document_type")
  reason         String
  severity       Int           @default(1)
  isShared       Boolean       @default(false) @map("is_shared")
  sharedAt       DateTime?     @map("shared_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  guest Guest @relation(fields: [guestId], references: [id])

  @@index([documentNumber])
  @@index([hotelId])
  @@index([guestId])
  @@index([isShared, documentNumber])
  @@map("guest_blacklist")
}

/// A birthday, anniversary or other date the hotel greets a guest on.
///
/// Month and day are stored separately from the year, and the year is optional,
/// because plenty of guests will give "14 August" but not the year — age is
/// sensitive information. A single DATE column would force us to invent a year
/// and then someone would compute an age from the fabricated value.
///
/// Deliberately separate from `Guest.dateOfBirth`: that field is compliance data
/// captured off an identity document, whereas this is opt-in relationship data.
/// Scanning a CNIC must not silently enrol someone into birthday emails.
model GuestSpecialDate {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId String @map("hotel_id") @db.Uuid
  guestId String @map("guest_id") @db.Uuid

  kind  SpecialDateKind @default(BIRTHDAY)
  /// Free-text name for a CUSTOM occasion ("First stay with us").
  label String?

  month Int
  day   Int
  /// Null when the guest shared the day and month but not the year.
  year  Int?

  /// Where the date came from — "GUEST", "FRONT_DESK", "BOOKING" — so a hotel
  /// can tell volunteered dates from inferred ones.
  source String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([guestId, kind, month, day])
  /// Drives the daily "whose occasion is coming up" sweep.
  @@index([hotelId, month, day])
  @@index([guestId])
  @@map("guest_special_dates")
}

// ============================================================================
// ACCOUNTING EXPORT
// ============================================================================

/// Maps a PMS concept onto a line in the hotel's own chart of accounts.
///
/// `scope` names what kind of thing `key` is, because the key spaces overlap and
/// are not all enums — expense categories are free text, so a single flat key
/// column would collide (a "TRANSPORT" folio item vs a "Transport" expense).
///
///   FOLIO_ITEM_TYPE  → FolioItemType   ("ROOM_CHARGE")
///   TAX_TYPE         → TaxType         ("GST")
///   PAYMENT_METHOD   → PaymentMethod   ("JAZZCASH")
///   EXPENSE_CATEGORY → free text       ("Utilities")
///   SYSTEM           → fixed accounts  ("ACCOUNTS_RECEIVABLE")
model AccountingAccount {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId String @map("hotel_id") @db.Uuid

  scope       String
  key         String
  accountCode String @map("account_code")
  accountName String @map("account_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, scope, key])
  @@index([hotelId])
  @@map("accounting_accounts")
}

/// One record per generated export file.
///
/// Exists to catch the worst failure mode of file-based accounting sync: the
/// same period exported twice and imported twice, silently doubling a month of
/// revenue. The UI warns on a period that already has a record, and the hash
/// lets us tell a genuine re-export from an identical re-download.
model AccountingExport {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId String @map("hotel_id") @db.Uuid

  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  format      String
  basis       String
  granularity String

  lineCount   Int    @map("line_count")
  /// Minor units. Debits and credits are stored separately so an unbalanced
  /// batch is visible in the history rather than hidden behind a net figure.
  totalDebit  Int    @map("total_debit")
  totalCredit Int    @map("total_credit")
  contentHash String @map("content_hash")

  generatedById String?  @map("generated_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, periodStart])
  @@index([hotelId, createdAt])
  @@map("accounting_exports")
}

