// ============================================================================
// ⚠️  NEVER RUN `prisma db push` ON THIS PROJECT ⚠️
//
//   Raw-SQL tables managed OUTSIDE this schema (via migration files only):
//     expenses, cash_accounts, ledger_entries, whatsapp_briefing_logs,
//     menu_categories, menu_items, qr_orders, qr_order_items
//
//   `prisma db push` syncs the DB to match THIS file exactly, which means
//   it SILENTLY DROPS every table not listed here — including all of the above.
//   This happened on 2026-07-15 and wiped all 8 tables with no warning.
//
//   ALWAYS use:
//     prisma migrate dev   — to create a new migration from schema changes
//     prisma migrate deploy — to apply existing migrations only
//
// ============================================================================
// Hotel PMS — Prisma Schema  v2.0
// Stack    : PostgreSQL 16 + Prisma ORM
// Updated  : Roles & Permissions tables added, HotelUser updated,
//            KITCHEN role added, indexing audit complete.
//
// MULTI-TENANCY
//   Every table carries hotel_id. RLS policies (rls_and_triggers.sql)
//   enforce isolation at DB level.
//
// ROLES & PERMISSIONS STRATEGY
//   Role, Permission, RolePermission are seeded EMPTY.
//   HotelUser keeps UserRole enum as fast JWT cache + roleId FK for Phase 2.
//
// NORMALIZATION
//   3NF throughout. Documented exceptions (trigger-maintained denormalisations):
//   - folio.balanceDue, guest.fullName, guest.totalStays, hotelUser.role
//
// MONEY
//   All monetary columns are Int (paise). Never Float. Rs 5000 = 500000.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // runtime: hotel_pms_app (subject to RLS)
  directUrl = env("DIRECT_URL") // migrations: pms_user superuser (bypasses RLS)
}

