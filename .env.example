# ── Database ──────────────────────────────────────────────────────────────────

# Runtime connection — hotel_pms_app role (subject to Row-Level Security).
# After running pnpm apply:rls, the API connects as this restricted role.
DATABASE_URL="postgresql://hotel_pms_app:pms_app_dev_pass@localhost:5433/hotel_pms?schema=public"

# Migration / admin connection — pms_user superuser (bypasses RLS).
# Used by: prisma migrate, apply-rls script, seed, prisma studio.
# NEVER use this URL in API route handlers.
DIRECT_URL="postgresql://pms_user:pms_pass@localhost:5433/hotel_pms?schema=public"

# Password for the restricted app DB role (set by pnpm apply:rls).
DB_APP_PASSWORD="pms_app_dev_pass"

# ── Authentication ────────────────────────────────────────────────────────────

# Secret used to sign access JWTs. Change to a strong random string in prod.
# Generate one with: openssl rand -base64 32
JWT_SECRET="change-me-in-production-use-openssl-rand-base64-32"

# How long an access token stays valid (short-lived for security).
JWT_EXPIRES_IN="1h"

# How long a refresh token stays valid.
JWT_REFRESH_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=development

# Allowed origin for hotel web app CORS (must match VITE dev port).
CORS_ORIGIN=http://localhost:5173

# Allowed origin for admin panel CORS.
ADMIN_CORS_ORIGIN=http://localhost:5174

# ── Redis ─────────────────────────────────────────────────────────────────────

# Used for WhatsApp briefing queue and background job scheduling.
REDIS_URL=redis://localhost:6379

# ── Admin panel ───────────────────────────────────────────────────────────────

# Super-admin credentials for the admin panel (localhost:5174).
ADMIN_EMAIL=admin@yourpms.com
ADMIN_PASSWORD=AdminPass123!

# Separate JWT secret for admin panel sessions. Change in production.
ADMIN_JWT_SECRET=admin-secret-change-in-prod

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Used for browser push notifications (service worker / push subscription API).
# The keys below are pre-generated dev keys — safe for local development.
# Generate fresh keys for production:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BD4e52ENQLZYIanWGDrpquG6nM3NnbdOPhE-psexBPL0St1xZp-8Bkhdn5YpwZYLHCQeA8lnrg7upIFSSELoPoE
VAPID_PRIVATE_KEY=7W8ulFu6cPxsYpWqDVbHjqvadEB-jbWfnGAf4QzsVuw
VAPID_EMAIL=mailto:admin@yourpms.com
