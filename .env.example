# ── Database ──────────────────────────────────────────────────────────────────

# Runtime connection — hotel_pms_app role (subject to Row-Level Security).
# After running pnpm apply:rls, the API connects as this restricted role.
DATABASE_URL="postgresql://hotel_pms_app:pms_app_dev_pass@localhost:5433/hotel_pms?schema=public"

# Migration / admin connection — pms_user superuser (bypasses RLS).
# Used by: prisma migrate, apply-rls script, seed, prisma studio.
# NEVER use this URL in API route handlers.
DIRECT_URL="postgresql://pms_user:pms_pass@localhost:5433/hotel_pms?schema=public"

# Password for the restricted app DB role (set by pnpm apply:rls).
DB_APP_PASSWORD="pms_app_dev_pass"

# ── Authentication ────────────────────────────────────────────────────────────

# Secret used to sign access JWTs. Change to a strong random string in prod.
# Generate one with: openssl rand -base64 32
JWT_SECRET="change-me-in-production-use-openssl-rand-base64-32"

# How long an access token stays valid (short-lived for security).
JWT_EXPIRES_IN="1h"

# How long a refresh token stays valid.
JWT_REFRESH_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────────────────

PORT=4000

# This file is the starting template for real deployments, so it defaults to the safe
# setting: "production". Anyone spinning up a real hotel_pms instance who forgets to
# touch this line stays safe by default. Local development is an explicit opt-in —
# copy this file, then set NODE_ENV=development and ALLOW_DEV_CORS_BYPASS=true
# yourself (see ALLOW_DEV_CORS_BYPASS below). Never flip this default the other way.
NODE_ENV=production

# Allowed origin for admin panel CORS (exact match).
ADMIN_CORS_ORIGIN=http://localhost:5174

# Base domain for the hotel web app's multi-tenant CORS check in production — every
# hotel gets its own subdomain (e.g. demo-hotel.innflo.co), so requests are allowed
# from the apex domain or any direct subdomain of this value.
PRODUCTION_DOMAIN=innflo.co

# Local-dev-only CORS bypass — allows any origin (e.g. localhost:5173) to call the API.
# Deliberately NOT set here: this file is the production template, and this flag must
# default to false/absent so a missing override never accidentally opens CORS in prod.
# For local development, uncomment the next line in your own copy (.env), never here:
# ALLOW_DEV_CORS_BYPASS=true

# Base URL other origins use to reach this API server — required in production (the
# API refuses to start without it once NODE_ENV=production). Uploaded file URLs
# (routes/upload.ts) are built from this value and stored/rendered on completely
# different origins (app.innflo.co, every *.innflo.co hotel subdomain), so it must be
# the API's real public origin, not a relative path or localhost.
API_PUBLIC_URL=https://api.innflo.co

# ── Redis ─────────────────────────────────────────────────────────────────────

# Used for WhatsApp briefing queue and background job scheduling.
REDIS_URL=redis://localhost:6379

# ── Admin panel ───────────────────────────────────────────────────────────────

# Super-admin credentials for the admin panel (localhost:5174).
ADMIN_EMAIL=admin@yourpms.com
ADMIN_PASSWORD=AdminPass123!

# Separate JWT secret for admin panel sessions. Change in production.
ADMIN_JWT_SECRET=admin-secret-change-in-prod

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Used for browser push notifications (service worker / push subscription API).
# The keys below are pre-generated dev keys — safe for local development.
# Generate fresh keys for production:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BD4e52ENQLZYIanWGDrpquG6nM3NnbdOPhE-psexBPL0St1xZp-8Bkhdn5YpwZYLHCQeA8lnrg7upIFSSELoPoE
VAPID_PRIVATE_KEY=7W8ulFu6cPxsYpWqDVbHjqvadEB-jbWfnGAf4QzsVuw
VAPID_EMAIL=mailto:admin@yourpms.com

# ── Image storage (Cloudinary) ────────────────────────────────────────────────
# Required for the inventory camera scan feature.
# Get these from: https://cloudinary.com → Dashboard → API Keys
# Free tier: 25 credits/month (enough for development and small hotels).
# V2 migration path: replace with AWS_BUCKET + AWS_REGION + AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Vision API (Google Cloud Vision) ─────────────────────────────────────────
# Required for the inventory camera scan feature.
# Get your key from: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Cloud Vision API (under APIs & Services → Library)
# Free tier: 1,000 image analyses/month.
# V2 migration path: replace with ANTHROPIC_API_KEY (Claude Vision gives structured JSON — no fuzzy matching needed)
GOOGLE_VISION_API_KEY=your_google_vision_api_key
