// ============================================================================
// Hotel PMS — Prisma Schema  v2.0
// Stack    : PostgreSQL 16 + Prisma ORM
// Updated  : Roles & Permissions tables added, HotelUser updated,
//            KITCHEN role added, indexing audit complete.
//
// MULTI-TENANCY
//   Every table carries hotel_id. RLS policies (rls_and_triggers.sql)
//   enforce isolation at DB level.
//
// ROLES & PERMISSIONS STRATEGY
//   Role, Permission, RolePermission are seeded EMPTY.
//   HotelUser keeps UserRole enum as fast JWT cache + roleId FK for Phase 2.
//
// NORMALIZATION
//   3NF throughout. Documented exceptions (trigger-maintained denormalisations):
//   - folio.balanceDue, guest.fullName, guest.totalStays, hotelUser.role
//
// MONEY
//   All monetary columns are Int (paise). Never Float. Rs 5000 = 500000.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // runtime: hotel_pms_app (subject to RLS)
  directUrl = env("DIRECT_URL")     // migrations: pms_user superuser (bypasses RLS)
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  OWNER
  MANAGER
  FRONT_DESK
  HOUSEKEEPING
  KITCHEN
  MAINTENANCE
  ACCOUNTANT
}

enum RoomStatus {
  VACANT_CLEAN
  VACANT_DIRTY
  OCCUPIED
  OUT_OF_ORDER
  UNDER_MAINTENANCE
  BLOCKED
}

enum RoomTypeName {
  SINGLE
  DOUBLE
  TWIN
  TRIPLE
  FAMILY
  SUITE
  DORMITORY
  COTTAGE
  TENT_GLAMPING
}

enum ReservationStatus {
  ENQUIRY
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
  CANCELLED
  WAITLISTED
}

enum BookingSource {
  WALK_IN
  PHONE
  WHATSAPP
  DIRECT_WEBSITE
  BOOKING_COM
  AGODA
  EXPEDIA
  AIRBNB
  BOOKME_PK
  SASTATICKET_PK
  TRAVEL_AGENT
  OTA_OTHER
}

enum GuestType {
  INDIVIDUAL
  GROUP
  CORPORATE
  TOUR_OPERATOR
}

enum PaymentMethod {
  CASH
  JAZZCASH
  EASYPAISA
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  CHEQUE
  ADVANCE_DEPOSIT
  OTA_COLLECT
  COMPLIMENTARY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIAL
}

enum FolioItemType {
  ROOM_CHARGE
  FOOD_BEVERAGE
  LAUNDRY
  TRANSPORT
  SPA
  ACTIVITY
  MINIBAR
  TELEPHONE
  INTERNET
  TAX
  DISCOUNT
  ADJUSTMENT
  DAMAGE_CHARGE
  MISCELLANEOUS
}

enum HousekeepingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  ESCALATED
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  AWAITING_PARTS
  RESOLVED
  CLOSED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MessageChannel {
  WHATSAPP
  BOOKING_COM
  AGODA
  EXPEDIA
  EMAIL
  SMS
  INTERNAL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum MessageStatus {
  RECEIVED
  READ
  REPLIED
  PENDING_SEND
  SENT
  DELIVERED
  FAILED
}

enum ChannelType {
  BOOKING_COM
  AGODA
  EXPEDIA
  AIRBNB
  BOOKME_PK
  SASTATICKET_PK
  CHANNEL_MANAGER
}

enum RatePlanType {
  STANDARD
  SEASONAL
  PROMOTIONAL
  CORPORATE
  TRAVEL_AGENT
  OTA_NET
  COMPLEMENTARY
}

enum InventoryTransactionType {
  PURCHASE
  CONSUMPTION
  WASTE
  ADJUSTMENT
  TRANSFER
  OPENING_STOCK
}

enum DocumentType {
  CNIC
  PASSPORT
  DRIVING_LICENSE
  NRIC
  OTHER
}

enum PropertyType {
  HOTEL
  GUESTHOUSE
  HOSTEL
  RESORT
  LODGE
  CAMPSITE
  SERVICED_APARTMENT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SUBMITTED_FBR
  ACCEPTED_FBR
  REJECTED_FBR
  VOID
}

enum TaxType {
  GST
  PST_PRA
  SST_SRB
  KPST_KPRA
  GBST_GBRA
  WHT
  ACCOMMODATION_TAX
}

// ============================================================================
// ROLES & PERMISSIONS  (v2 addition — tables seeded EMPTY)
// hotelId = NULL on system roles (apply to all hotels)
// hotelId = set   on custom roles (hotel-specific, Phase 2)
// ============================================================================

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId     String?  @db.Uuid @map("hotel_id")

  name        String               // "OWNER" | "MANAGER" etc. — matches UserRole enum
  displayName String @map("display_name") // "Front Desk Staff"
  description String?
  color       String   @default("#6B7280")
  isSystem    Boolean  @default(true) @map("is_system")
  isCustom    Boolean  @default(false) @map("is_custom")
  sortOrder   Int      @default(0) @map("sort_order")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  hotel       Hotel?         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  hotelUsers  HotelUser[]

  @@unique([hotelId, name])
  @@index([hotelId])
  @@index([isSystem])
  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique   // "payments:refund" — matches TS Permission type
  module      String             // "payments"
  action      String             // "refund"
  displayName String @map("display_name") // "Issue Refunds"
  description String?

  createdAt   DateTime @default(now()) @map("created_at")

  roles       RolePermission[]

  @@index([module])
  @@index([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String   @db.Uuid @map("role_id")
  permissionId String   @db.Uuid @map("permission_id")
  grantedAt    DateTime @default(now()) @map("granted_at")
  grantedBy    String?  @db.Uuid @map("granted_by") // userId who granted

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ============================================================================
// CORE — Hotels and Users
// ============================================================================

model Hotel {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  slug             String       @unique
  propertyType     PropertyType @default(HOTEL) @map("property_type")

  phone            String?
  whatsappNumber   String? @map("whatsapp_number")
  email            String?
  website          String?

  address          String?
  city             String?
  region           String?
  province         String?
  country          String       @default("PK")
  latitude         Decimal?     @db.Decimal(10, 7)
  longitude        Decimal?     @db.Decimal(10, 7)
  googlePlaceId    String? @map("google_place_id")

  ntn              String?
  strn             String?
  fbrPosId         String? @map("fbr_pos_id")

  settings         Json         @default("{}")

  isActive         Boolean      @default(true) @map("is_active")
  isTrialAccount   Boolean      @default(true) @map("is_trial_account")
  trialEndsAt      DateTime? @map("trial_ends_at")
  onboardedAt      DateTime? @map("onboarded_at")

  subdomain           String?  @unique @map("subdomain")
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  onboardingStep      Int      @default(0) @map("onboarding_step")

  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  roles                 Role[]
  users                 HotelUser[]
  roomTypes             RoomType[]
  rooms                 Room[]
  guests                Guest[]
  reservations          Reservation[]
  folios                Folio[]
  payments              Payment[]
  housekeepingTasks     HousekeepingTask[]
  maintenanceTickets    MaintenanceTicket[]
  messages              Message[]
  conversations         Conversation[]
  posCategories         PosCategory[]
  posItems              PosItem[]
  posOrders             PosOrder[]
  ratePlans             RatePlan[]
  channels              ChannelConfig[]
  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  staff                 Staff[]
  shiftReports          ShiftReport[]
  invoices              Invoice[]
  taxConfigs            TaxConfig[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  customFields          CustomFieldDefinition[]
  frontDeskNotes        FrontDeskNote[]
  pushSubscriptions     PushSubscription[]

  @@index([slug])
  @@index([isActive])
  @@index([region])
  @@map("hotels")
}

model User {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String      @unique
  phone                String?     @unique
  passwordHash         String @map("password_hash")
  name                 String
  avatarUrl            String? @map("avatar_url")

  emailVerified        Boolean     @default(false) @map("email_verified")
  phoneVerified        Boolean     @default(false) @map("phone_verified")
  lastLoginAt          DateTime? @map("last_login_at")
  refreshTokenHash     String? @map("refresh_token_hash")
  passwordResetToken   String? @map("password_reset_token")
  passwordResetExpiry  DateTime? @map("password_reset_expiry")

  preferredLanguage    String      @default("en") @map("preferred_language")
  timezone             String      @default("Asia/Karachi")

  isSuperAdmin         Boolean     @default(false) @map("is_super_admin")
  isFirstLogin         Boolean     @default(true)  @map("is_first_login")
  tempPassword         String?     @map("temp_password")

  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  hotels                HotelUser[]
  auditLogs             AuditLog[]
  assignedTasks         HousekeepingTask[]   @relation("assignedTo")
  assignedMaintenance   MaintenanceTicket[]  @relation("assignedMaintenance")
  assignedConversations Conversation[]
  notesCreated          FrontDeskNote[]      @relation("NoteCreatedBy")
  notesCompleted        FrontDeskNote[]      @relation("NoteCompletedBy")
  pushSubscriptions     PushSubscription[]

  @@index([deletedAt])
  @@map("users")
}

// Updated in v2: adds roleId FK to Role table.
// role (enum) is kept as fast cache for JWT — always in sync with Role.name.
model HotelUser {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId     String    @db.Uuid @map("hotel_id")
  userId      String    @db.Uuid @map("user_id")
  role        UserRole            // fast enum cache for JWT and can() checks
  roleId      String    @db.Uuid @map("role_id") // FK to Role table for DB-driven permissions
  isActive    Boolean   @default(true) @map("is_active")
  invitedAt   DateTime  @default(now()) @map("invited_at")
  acceptedAt  DateTime? @map("accepted_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedRole Role     @relation(fields: [roleId], references: [id])

  @@unique([hotelId, userId])
  @@index([hotelId])
  @@index([userId])
  @@index([hotelId, role])
  @@index([roleId])
  @@map("hotel_users")
}

// ============================================================================
// ROOMS
// ============================================================================

model RoomType {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId         String       @db.Uuid @map("hotel_id")
  name            String
  typeName        RoomTypeName @default(DOUBLE) @map("type_name")
  description     String?
  maxOccupancy    Int @map("max_occupancy")
  defaultRate     Int @map("default_rate")
  extraBedRate    Int          @default(0) @map("extra_bed_rate")
  amenities       String[]
  photoUrls       String[] @map("photo_urls")
  sortOrder       Int          @default(0) @map("sort_order")
  isActive        Boolean      @default(true) @map("is_active")

  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  hotel            Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rooms            Room[]
  ratePlanItems    RatePlanItem[]
  reservationRooms ReservationRoom[]

  @@index([hotelId])
  @@index([hotelId, isActive])
  @@map("room_types")
}

model Room {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId         String      @db.Uuid @map("hotel_id")
  roomTypeId      String      @db.Uuid @map("room_type_id")
  number          String
  floor           Int?
  status          RoomStatus  @default(VACANT_CLEAN)
  notes           String?
  isActive        Boolean     @default(true) @map("is_active")

  lastCleanedAt   DateTime? @map("last_cleaned_at")
  lastCheckedAt   DateTime? @map("last_checked_at")
  lastInspectedBy String?     @db.Uuid @map("last_inspected_by")

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  hotel              Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType           RoomType           @relation(fields: [roomTypeId], references: [id])
  reservationRooms   ReservationRoom[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]

  @@unique([hotelId, number])
  @@index([hotelId])
  @@index([hotelId, status])
  @@index([hotelId, isActive])
  @@index([roomTypeId])
  @@map("rooms")
}

// ============================================================================
// GUESTS
// ============================================================================

model Guest {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId          String       @db.Uuid @map("hotel_id")

  firstName        String @map("first_name")
  lastName         String @map("last_name")
  fullName         String @map("full_name")
  email            String?
  phone            String?
  alternatePhone   String? @map("alternate_phone")
  nationality      String?
  isForeigner      Boolean      @default(false) @map("is_foreigner")
  language         String?

  documentType     DocumentType @default(CNIC) @map("document_type")
  documentNumber   String? @map("document_number")
  documentExpiry   DateTime? @map("document_expiry")
  documentScanUrl  String? @map("document_scan_url")
  dateOfBirth      DateTime? @map("date_of_birth")
  gender           String?

  address          String?
  city             String?
  country          String?

  totalStays       Int          @default(0) @map("total_stays")
  totalSpend       Int          @default(0) @map("total_spend")
  vipLevel         Int          @default(0) @map("vip_level")
  tags             String[]
  internalNotes    String? @map("internal_notes")
  isBlacklisted    Boolean      @default(false) @map("is_blacklisted")
  blacklistReason  String? @map("blacklist_reason")

  source           BookingSource?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  hotel            Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservations     Reservation[]
  groupMembers     GroupMember[]
  conversations    Conversation[]
  blacklistEntries GuestBlacklist[]

  searchVector     Unsupported("tsvector")?

  @@index([hotelId])
  @@index([hotelId, documentNumber])
  @@index([hotelId, phone])
  @@index([hotelId, isBlacklisted])
  @@index([hotelId, isForeigner])
  @@index([hotelId, deletedAt])
  @@index([hotelId, vipLevel])
  @@map("guests")
}

model GuestBlacklist {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId         String       @db.Uuid @map("hotel_id")
  guestId         String       @db.Uuid @map("guest_id")
  documentNumber  String? @map("document_number")
  documentType    DocumentType? @map("document_type")
  reason          String
  severity        Int          @default(1)
  isShared        Boolean      @default(false) @map("is_shared")
  sharedAt        DateTime? @map("shared_at")

  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  guest           Guest        @relation(fields: [guestId], references: [id])

  @@index([documentNumber])
  @@index([hotelId])
  @@index([guestId])
  @@index([isShared, documentNumber])
  @@map("guest_blacklist")
}

// ============================================================================
// RESERVATIONS
// ============================================================================

model Reservation {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId             String            @db.Uuid @map("hotel_id")
  guestId             String            @db.Uuid @map("guest_id")
  groupId             String?           @db.Uuid @map("group_id")

  confirmationNumber  String            @unique @map("confirmation_number")
  source              BookingSource     @default(WALK_IN)
  otaBookingRef       String? @map("ota_booking_ref")
  status              ReservationStatus @default(CONFIRMED)
  guestType           GuestType         @default(INDIVIDUAL) @map("guest_type")

  checkInDate         DateTime          @db.Date @map("check_in_date")
  checkOutDate        DateTime          @db.Date @map("check_out_date")
  actualCheckIn       DateTime? @map("actual_check_in")
  actualCheckOut      DateTime? @map("actual_check_out")

  adults              Int               @default(1)
  children            Int               @default(0)
  infants             Int               @default(0)

  quotedRate          Int               @default(0) @map("quoted_rate")
  totalAmount         Int               @default(0) @map("total_amount")
  discountAmount      Int               @default(0) @map("discount_amount")
  advancePaid         Int               @default(0) @map("advance_paid")
  balanceDue          Int               @default(0) @map("balance_due")

  specialRequests     String? @map("special_requests")
  internalNotes       String? @map("internal_notes")
  dietaryRequirements String? @map("dietary_requirements")
  purposeOfVisit      String? @map("purpose_of_visit")
  arrivalMode         String? @map("arrival_mode")
  estimatedArrivalTime DateTime? @map("estimated_arrival_time")

  cancellationReason  String? @map("cancellation_reason")
  cancelledAt         DateTime? @map("cancelled_at")
  cancelledBy         String?           @db.Uuid @map("cancelled_by")
  cancellationFee     Int               @default(0) @map("cancellation_fee")

  isWalkIn            Boolean           @default(false) @map("is_walk_in")
  requiresPickup      Boolean           @default(false) @map("requires_pickup")
  isVip               Boolean           @default(false) @map("is_vip")

  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  createdBy           String?           @db.Uuid @map("created_by")

  hotel               Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guest               Guest             @relation(fields: [guestId], references: [id])
  group               GroupBooking?     @relation(fields: [groupId], references: [id])
  rooms               ReservationRoom[]
  folio               Folio?
  payments            Payment[]
  messages            Message[]

  @@index([hotelId, status])
  @@index([hotelId, checkInDate])
  @@index([hotelId, checkOutDate])
  @@index([hotelId, guestId])
  @@index([hotelId, source])
  @@index([hotelId, createdAt])
  @@index([hotelId, otaBookingRef])
  @@index([hotelId, checkInDate, status])
  @@map("reservations")
}

model ReservationRoom {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId   String      @db.Uuid @map("reservation_id")
  roomId          String      @db.Uuid @map("room_id")
  roomTypeId      String      @db.Uuid @map("room_type_id")
  guestId         String?     @db.Uuid @map("guest_id")
  ratePerNight    Int @map("rate_per_night")
  checkInDate     DateTime    @db.Date @map("check_in_date")
  checkOutDate    DateTime    @db.Date @map("check_out_date")
  actualCheckIn   DateTime? @map("actual_check_in")
  actualCheckOut  DateTime? @map("actual_check_out")
  notes           String?

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  room            Room        @relation(fields: [roomId], references: [id])
  roomType        RoomType    @relation(fields: [roomTypeId], references: [id])

  @@index([reservationId])
  @@index([roomId])
  @@index([roomId, checkInDate, checkOutDate])
  @@index([roomTypeId])
  @@map("reservation_rooms")
}

// ============================================================================
// GROUP BOOKINGS
// ============================================================================

model GroupBooking {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId          String    @db.Uuid @map("hotel_id")
  name             String
  groupRef         String? @map("group_ref")
  tourOperatorId   String?   @db.Uuid @map("tour_operator_id")

  billingType      String    @default("SPLIT") @map("billing_type")
  payerType        String    @default("GUEST") @map("payer_type")
  payerName        String? @map("payer_name")
  payerContact     String? @map("payer_contact")

  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  reservations     Reservation[]
  members          GroupMember[]

  @@index([hotelId])
  @@index([hotelId, tourOperatorId])
  @@map("group_bookings")
}

model GroupMember {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId       String       @db.Uuid @map("group_id")
  guestId       String       @db.Uuid @map("guest_id")
  isLeader      Boolean      @default(false) @map("is_leader")
  roomPreference String? @map("room_preference")

  createdAt     DateTime     @default(now()) @map("created_at")

  group         GroupBooking @relation(fields: [groupId], references: [id], onDelete: Cascade)
  guest         Guest        @relation(fields: [guestId], references: [id])

  @@unique([groupId, guestId])
  @@index([groupId])
  @@index([guestId])
  @@map("group_members")
}

// ============================================================================
// FOLIO & PAYMENTS
// ============================================================================

model Folio {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId         String    @db.Uuid @map("hotel_id")
  reservationId   String    @unique @db.Uuid @map("reservation_id")
  folioNumber     String    @unique @map("folio_number")

  chargesTotal    Int       @default(0) @map("charges_total")
  discountsTotal  Int       @default(0) @map("discounts_total")
  taxTotal        Int       @default(0) @map("tax_total")
  paymentsTotal   Int       @default(0) @map("payments_total")
  balanceDue      Int       @default(0) @map("balance_due")

  isOpen          Boolean   @default(true) @map("is_open")
  closedAt        DateTime? @map("closed_at")
  closedBy        String?   @db.Uuid @map("closed_by")

  invoiceId       String?   @db.Uuid @map("invoice_id")

  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  hotel       Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id])
  items       FolioItem[]
  payments    Payment[]
  splitFolios FolioSplit[]
  invoice     Invoice?    @relation(fields: [invoiceId], references: [id])

  @@index([hotelId])
  @@index([hotelId, isOpen])
  @@index([hotelId, closedAt])
  @@map("folios")
}

model FolioItem {
