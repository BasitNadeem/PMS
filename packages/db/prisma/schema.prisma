model PosItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotelId     String  @map("hotel_id") @db.Uuid
  categoryId  String  @map("category_id") @db.Uuid
  name        String
  nameUrdu    String? @map("name_urdu")
  description String?
